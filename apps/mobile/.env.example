# Supabase project config (Project Settings > API)
# The app runs entirely on local mock data without these for Week 1.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth Web Client ID (Supabase dashboard > Authentication > Providers >
# Google > Client IDs — must match the client Supabase's Google provider is
# configured with, not a new one). Only needed inside the EAS dev-client build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK key (Week 3)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
